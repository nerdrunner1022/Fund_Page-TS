# Copy to .env and fill in. Never commit the real .env.
NODE_ENV=development
PORT=3000

# Pooled Postgres connection string used by the running API.
# On Neon, `neon deploy` fills this with the -pooler endpoint.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/zahira_fund

# Direct (non-pooled) connection string used by migrations and seed scripts.
# Neon supplies this automatically; leave unset for local Postgres/Docker.
# DATABASE_URL_UNPOOLED=

# Optional SELECT-only connection used by the public totals endpoint.
# See apps/api/src/database/readonly-role.sql. If unset, the pooled app URL is used.
# READONLY_DATABASE_URL=

# At least 32 characters. Used to sign admin JWTs.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Seeded admin. Password must be at least 12 characters; it is bcrypt-hashed on seed.
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=replace-with-a-strong-password

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Campaign served by the API.
CAMPAIGN_SLUG=zahira-college-land-fund

# Global API rate limit per minute. The donation POST has its own stricter
# 5/minute limit; this one must also cover the page's 30s refresh + CORS preflight.
THROTTLE_LIMIT=100
THROTTLE_TTL_MS=60000

# Set to true only for throwaway local/test databases (synchronize schema from entities).
DB_SYNCHRONIZE=false

# Test-only: use an in-memory Postgres-compatible database instead of DATABASE_URL.
# Never enable this in production (startup validation enforces this).
USE_MEMORY_DB=false

# Set to true only when the API is deployed behind a single trusted reverse proxy,
# so rate limiting keys on X-Forwarded-For instead of the proxy's address.
TRUST_PROXY=false
